# Copy to infrastructure/.env and change the password. Never commit .env.
POSTGRES_DB=investary
POSTGRES_USER=investary
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- AI providers (Phase 3). Leave as "none" to run without AI: the knowledge base then waits
# --- and the assistant reports that it is not configured. Local default: Ollama (https://ollama.com).
# ollama pull bge-m3 && ollama pull qwen3:8b
INVESTARY_AI_EMBEDDING_PROVIDER=none
INVESTARY_AI_CHAT_PROVIDER=none
INVESTARY_OLLAMA_BASE_URL=http://localhost:11434
INVESTARY_EMBEDDING_MODEL=bge-m3
INVESTARY_EMBEDDING_DIMENSIONS=1024
INVESTARY_CHAT_MODEL=qwen3:8b

# --- Gmail sync (Phase 5 / Milestone 1). Leave empty to keep Gmail disabled. Setup: docs/phase-5-milestone-1.md
# --- Token key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INVESTARY_GMAIL_CLIENT_ID=
INVESTARY_GMAIL_CLIENT_SECRET=
INVESTARY_GMAIL_TOKEN_KEY=
# INVESTARY_GMAIL_SYNC_INTERVAL=30m
# INVESTARY_GMAIL_INITIAL_LOOKBACK_DAYS=30
