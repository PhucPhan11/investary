{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "investary-frontend": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "polyfills": [
              "@angular/localize/init"
            ],
            "localize": true,
            "i18nMissingTranslation": "error"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "vi": {
              "localize": [
                "vi"
              ],
              "baseHref": "/",
              "define": {
                "INVESTARY_ALT_LANGUAGE_URL": "\"http://localhost:4201\""
              }
            },
            "en": {
              "localize": [
                "en"
              ],
              "baseHref": "/",
              "define": {
                "INVESTARY_ALT_LANGUAGE_URL": "\"http://localhost:4200\""
              }
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "investary-frontend:build:production,vi"
            },
            "development": {
              "buildTarget": "investary-frontend:build:development,vi",
              "port": 4200
            },
            "en": {
              "buildTarget": "investary-frontend:build:development,en",
              "port": 4201
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "investary-frontend:build:development"
          }
        }
      },
      "i18n": {
        "sourceLocale": "en",
        "locales": {
          "vi": {
            "translation": "src/locale/messages.vi.xlf",
            "baseHref": "/vi/"
          }
        }
      }
    }
  }
}
