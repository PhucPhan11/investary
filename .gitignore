# --- Secrets / local env ---
.env
*.env.local
!.env.example

# --- Uploaded financial documents and emails (never commit) ---
storage/
# Java packages named "storage" are source code, not uploads
!backend/src/main/java/**/storage/
!backend/src/test/java/**/storage/
*.pdf
*.eml
# Synthetic, sanitized test fixtures only
!backend/src/test/resources/eml/*.eml

# --- Backend ---
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar

# --- Frontend ---
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/coverage/

# --- IDE / OS ---
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.log
*.stackdump

# --- graphify code map (see AGENTS.md "Code map") ---
# Commit only GRAPH_REPORT.md, graph.json, graph.html and the community labels; the rest is machine-local state.
graphify-out/cache/
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/.graphify_*
!graphify-out/.graphify_labels.json
graphify-out/*-graph.json
**/graphify-out/
!/graphify-out/
