# --- Secrets / local env ---
.env
*.env.local
!.env.example

# --- Uploaded financial documents and emails (never commit) ---
storage/
# Java packages named "storage" are source code, not uploads
!backend/src/main/java/**/storage/
!backend/src/test/java/**/storage/
*.pdf
*.eml
# Synthetic, sanitized test fixtures only
!backend/src/test/resources/eml/*.eml

# --- Backend ---
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar

# --- Frontend ---
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/coverage/

# --- IDE / OS ---
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.log
